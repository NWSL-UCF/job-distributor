[Unit]
Description=JobDistributor Hub (Gunicorn)
After=network.target mysql.service

[Service]
Type=simple
User=hub
Group=hub
WorkingDirectory=/opt/hub

# Load secrets from .env — keep this file chmod 600
EnvironmentFile=/opt/hub/hub/.env

ExecStart=/opt/hub/venv/bin/gunicorn "hub.wsgi:app" \
    --workers=1 \
    --threads=4 \
    --bind=127.0.0.1:5000 \
    --access-logfile /var/log/hub/access.log \
    --error-logfile  /var/log/hub/error.log \
    --log-level info \
    --timeout 120

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
