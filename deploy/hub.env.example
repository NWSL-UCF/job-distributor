# Copy this file to deploy/hub.env and fill in every value.
# hub.env is mounted read-only into the hub container at /app/hub/.env

# ── Email (Brevo) ──────────────────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=info@jobdistributor.net
BREVO_FROM_NAME=JobDistributor Team
# Public support address shown in UI footers and outgoing emails.
SUPPORT_EMAIL=info@jobdistributor.net
# Admin inbox(es) for extension-request alerts (comma-separated). Optional if admin users exist.
HUB_ADMIN_EMAIL=admin@yourdomain.com

# ── Database ───────────────────────────────────────────────────────────────────
# MySQL is running on the VPS host — use host.docker.internal to reach it
# from inside the container.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=hub_user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=jd_hub

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=your-flask-secret-key-long-random-string
FLASK_ENV=production

# ── Hub ────────────────────────────────────────────────────────────────────────
HUB_BASE_URL=https://hub.jobdistributor.net
JD_BASE_DOMAIN=jobdistributor.net

# ── FRP ────────────────────────────────────────────────────────────────────────
# No global FRPS_TOKEN needed — authentication is per-experiment via the
# Login plugin hook (each experiment carries its own frpc_token in metadata).
# frps admin API — reachable via Docker service name
FRPS_API_URL=http://frps:7500

# ── JWT signing ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-long-random-string
# How long a worker JWT is valid (hours). Workers refresh before this expires.
JWT_WORKER_TOKEN_TTL_HOURS=6
# How many seconds before expiry workers proactively refresh their token.
# Must be less than JWT_WORKER_TOKEN_TTL_HOURS × 3600.
# Returned to workers in the token response — no client redeploy needed to change it.
JWT_REFRESH_MARGIN_SECS=1800

# ── Session ────────────────────────────────────────────────────────────────────
HUB_SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=

# ── OTP ────────────────────────────────────────────────────────────────────────
OTP_VERIFY_EXPIRE_MINUTES=30
OTP_RESET_EXPIRE_MINUTES=15
