# Copy this file to .env and fill in real values.

# ── Email (Brevo) ──────────────────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=info@jobdistributor.net
BREVO_FROM_NAME=JobDistributor Team

# ── Database ───────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=hub_user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=jd_hub

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=your-flask-secret-key
FLASK_ENV=production

# ── Hub ────────────────────────────────────────────────────────────────────────
HUB_BASE_URL=https://hub.jobdistributor.net
JD_BASE_DOMAIN=jobdistributor.net

# ── FRP ────────────────────────────────────────────────────────────────────────
FRPS_TOKEN=your-frps-shared-secret
FRPS_API_URL=http://localhost:7500

# ── JWT signing ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key
JWT_WORKER_TOKEN_TTL_HOURS=24

# ── Session ────────────────────────────────────────────────────────────────────
HUB_SESSION_TTL_DAYS=30
# Empty = auto (Secure cookie only on HTTPS). Use 0 while testing on http://:5000
SESSION_COOKIE_SECURE=

# ── OTP (email verification & password reset) ─────────────────────────────────
OTP_VERIFY_EXPIRE_MINUTES=30
OTP_RESET_EXPIRE_MINUTES=15
